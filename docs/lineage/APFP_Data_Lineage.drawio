nalLoop=1;fontSize=11;fontColor=#5F6C77;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b19" target="b20"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page16" name="16. Glossary and key"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="866" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object label="Glossary and key" id="t1"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=26;fontColor=#0E4A5C;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:13px"&gt;Source&lt;/b&gt;' id="b2"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#0E4A5C;strokeColor=#0E4A5C;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="260" height="56" as="geometry"/></mxCell></object><object label='&lt;font style="font-size:12px" color="#5F6C77"&gt;The Central Administration workbook where people type the data.&lt;/font&gt;' id="b3"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5DA;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="310" y="90" width="760" height="56" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:13px"&gt;Staging (stg_)&lt;/b&gt;' id="b4"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#0E4A5C;strokeColor=#0E4A5C;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="156" width="260" height="56" as="geometry"/></mxCell></object><object label='&lt;font style="font-size:12px" color="#5F6C77"&gt;A cleaned copy of one source tab: simple names, right types, no calculations.&lt;/font&gt;' id="b5"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5DA;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="310" y="156" width="760" height="56" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:13px"&gt;Final (fct_)&lt;/b&gt;' id="b6"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#0E4A5C;strokeColor=#0E4A5C;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="222" width="260" height="56" as="geometry"/></mxCell></object><object label='&lt;font style="font-size:12px" color="#5F6C77"&gt;A dashboard-ready table built from staging tables: joined, calculated, ready to show.&lt;/font&gt;' id="b7"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5DA;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="310" y="222" width="760" height="56" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:13px"&gt;Column and row&lt;/b&gt;' id="b8"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#0E4A5C;strokeColor=#0E4A5C;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="288" width="260" height="56" as="geometry"/></mxCell></object><object label='&lt;font style="font-size:12px" color="#5F6C77"&gt;A column is one field (for example Approved amount); a row is one record (for example one grant).&lt;/font&gt;' id="b9"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5DA;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="310" y="288" width="760" height="56" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:13px"&gt;Grain&lt;/b&gt;' id="b10"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#0E4A5C;strokeColor=#0E4A5C;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="354" width="260" height="56" as="geometry"/></mxCell></object><object label='&lt;font style="font-size:12px" color="#5F6C77"&gt;What one row means, for example one row per grant, or per grant and outcome and quarter.&lt;/font&gt;' id="b11"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5DA;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="310" y="354" width="760" height="56" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:13px"&gt;Key / identifier&lt;/b&gt;' id="b12"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#0E4A5C;strokeColor=#0E4A5C;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="260" height="56" as="geometry"/></mxCell></object><object label='&lt;font style="font-size:12px" color="#5F6C77"&gt;A column that identifies a record or links two tables, such as Grant ID or Organisation ID.&lt;/font&gt;' id="b13"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5DA;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="310" y="420" width="760" height="56" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:13px"&gt;Flag&lt;/b&gt;' id="b14"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#0E4A5C;strokeColor=#0E4A5C;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="486" width="260" height="56" as="geometry"/></mxCell></object><object label='&lt;font style="font-size:12px" color="#5F6C77"&gt;A true or false column, for example "is an active grant".&lt;/font&gt;' id="b15"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5DA;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="310" y="486" width="760" height="56" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:13px"&gt;Calculated column (ƒ)&lt;/b&gt;' id="b16"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#0E4A5C;strokeColor=#0E4A5C;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="552" width="260" height="56" as="geometry"/></mxCell></object><object label='&lt;font style="font-size:12px" color="#5F6C77"&gt;A column worked out from other columns, not copied.&lt;/font&gt;' id="b17"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5DA;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="310" y="552" width="760" height="56" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:13px"&gt;Metric&lt;/b&gt;' id="b18"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#0E4A5C;strokeColor=#0E4A5C;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="618" width="260" height="56" as="geometry"/></mxCell></object><object label='&lt;font style="font-size:12px" color="#5F6C77"&gt;A number on the dashboard made by counting or adding final columns, for example Grantees.&lt;/font&gt;' id="b19"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5DA;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="310" y="618" width="760" height="56" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:13px"&gt;Chart-level filter&lt;/b&gt;' id="b20"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#0E4A5C;strokeColor=#0E4A5C;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="684" width="260" height="56" as="geometry"/></mxCell></object><object label='&lt;font style="font-size:12px" color="#5F6C77"&gt;A condition on one chart, for example "active grants only", so one metric serves many charts.&lt;/font&gt;' id="b21"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5DA;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="310" y="684" width="760" height="56" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:13px"&gt;Pipeline run&lt;/b&gt;' id="b22"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#0E4A5C;strokeColor=#0E4A5C;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="260" height="56" as="geometry"/></mxCell></object><object label='&lt;font style="font-size:12px" color="#5F6C77"&gt;One go of the scripts: check, clean, build, test. Recorded in the Pipeline Log tab.&lt;/font&gt;' id="b23"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5DA;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="310" y="750" width="760" height="56" a