26" width="30" height="16" as="geometry"/></mxCell></object><object label="" id="b43"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#9AA7B0;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1260" y="326" width="30" height="16" as="geometry"/></mxCell></object><object label="Looked up from another table by a key" id="t44"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#1E2838;" vertex="1" parent="1"><mxGeometry x="1300" y="324" width="170" height="30" as="geometry"/></mxCell></object><object label="" id="b45"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#9AA7B0;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1154" y="354" width="30" height="16" as="geometry"/></mxCell></object><object label="" id="b46"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#9AA7B0;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1260" y="354" width="30" height="16" as="geometry"/></mxCell></object><object label="Calculated (the ƒ sign marks a calculated column)" id="t47"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#1E2838;" vertex="1" parent="1"><mxGeometry x="1300" y="352" width="170" height="30" as="geometry"/></mxCell></object><object label="&lt;b style=&quot;font-size:14px&quot;&gt;For the team: keeping this diagram right&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F6C77&quot;&gt;1  Open this file in draw.io (app.diagrams.net).&lt;br&gt;2  When a column is added, renamed or removed in the&lt;br&g