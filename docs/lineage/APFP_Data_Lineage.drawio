<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="page1" name="1. How the pieces fit"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="570" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object label="How the pieces fit" id="t1"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=26;fontColor=#0E4A5C;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell></object><object label="Where the data is typed, what changes it, where it is stored and where people see it. Plain words first; technical names are in brackets." id="t2"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#5F6C77;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1500" height="24" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:14px"&gt;Programme teams&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;Enter and update grants, outcomes, support requests, decisions and payments.&lt;/font&gt;' id="b3"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#F4F6F9;strokeColor=#B9C5CB;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="260" height="140" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:14px"&gt;APFP Central Administration&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;Google Sheets workbook, 8 tabs.&lt;br&gt;The only place data is typed in. The pipeline never changes it.&lt;/font&gt;' id="b4"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="370" y="130" width="280" height="140" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:14px"&gt;Pipeline scripts&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;Google Apps Script, run on demand.&lt;br&gt;1 Check the source columns  2 Clean each tab&lt;br&gt;3 Build the dashboard tables  4 Run the tests&lt;/font&gt;' id="b5"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="720" y="130" width="300" height="140" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:14px"&gt;Data Pipeline workbook&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;Google Sheets workbook.&lt;br&gt;Cleaned tabs (stg_) and dashboard-ready tabs (fct_), plus Index, Pipeline Log and test results.&lt;/font&gt;' id="b6"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="130" width="300" height="140" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:14px"&gt;Looker Studio dashboard&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;5 pages: Guide, Portfolio Overview, Funding Allocation, Decision Queue, Grantee 360.&lt;/font&gt;' id="b7"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1460" y="130" width="280" height="140" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:14px"&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;Keeps the code and every change (who, when, why).&lt;br&gt;clasp copies the code into Apps Script.&lt;/font&gt;' id="b8"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#F4F6F9;strokeColor=#B9C5CB;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="720" y="360" width="300" height="110" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:14px"&gt;Control tabs in the workbook&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;Index (all tab names), Pipeline Log (every run),&lt;br&gt;Source_Header_Audit, Cardinality Test Results.&lt;/font&gt;' id="b9"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#F4F6F9;strokeColor=#B9C5CB;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1090" y="360" width="300" height="110" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:14px"&gt;Good to know&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;The pipeline is run by hand today; there is no schedule.&lt;br&gt;If a source column is renamed or removed, the run stops and the owner is emailed, so a broken column never reaches the dashboard.&lt;br&gt;There is no intermediate layer: each dashboard table is built directly from the cleaned tables.&lt;/font&gt;' id="b10"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#167C88;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="600" height="150" as="geometry"/></mxCell></object><mxCell id="e0" value="type data" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#5F6C77;strokeWidth=1.6;jettySize=auto;orthogonalLoop=1;fontSize=11;fontColor=#5F6C77;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="read" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#5F6C77;strokeWidth=1.6;jettySize=auto;orthogonalLoop=1;fontSize=11;fontColor=#5F6C77;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="write" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#5F6C77;strokeWidth=1.6;jettySize=auto;orthogonalLoop=1;fontSize=11;fontColor=#5F6C77;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="read" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#5F6C77;strokeWidth=1.6;jettySize=auto;orthogonalLoop=1;fontSize=11;fontColor=#5F6C77;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="clasp push" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#5F6C77;strokeWidth=1.6;jettySize=auto;orthogonalLoop=1;fontSize=11;fontColor=#5F6C77;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b8" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="holds" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#5F6C77;strokeWidth=1.6;jettySize=auto;orthogonalLoop=1;fontSize=11;fontColor=#5F6C77;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b6" target="b9"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="2. The journey of the data"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1860" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object label="The journey of the data" id="t1"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=26;fontColor=#0E4A5C;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="30" as="geometry"/></mxCell></object><object label="Four steps from what people type to what the dashboard shows. Each step is its own set of tabs, so a problem can be traced to one step." id="t2"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#5F6C77;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1500" height="24" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:18px"&gt;Source&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#E2F2F4"&gt;8 tabs, Central Administration workbook&lt;/font&gt;' id="b3"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#5F6C77;strokeColor=#5F6C77;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="380" height="70" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:13px"&gt;What happens here&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;Typed by people.&lt;br&gt;Never changed by the pipeline.&lt;/font&gt;' id="b4"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5DA;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="380" height="120" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:13px"&gt;Tabs&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;Grant register&lt;br&gt;Organisation register&lt;br&gt;Decision tracker&lt;br&gt;Outcome progress&lt;br&gt;Organisation maturity&lt;br&gt;Support requests&lt;br&gt;Committed and spent tracker&lt;br&gt;Dividends&lt;/font&gt;' id="b5"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#F4F6F9;strokeColor=#CBD5DA;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="332" width="380" height="238" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:18px"&gt;Staging&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#E2F2F4"&gt;8 tables, prefix stg_&lt;/font&gt;' id="b6"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#167C88;strokeColor=#167C88;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="490" y="110" width="380" height="70" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:13px"&gt;What happens here&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;A cleaned copy of each source tab:&lt;br&gt;keep the columns we use, simple names,&lt;br&gt;right data types, years as FY 26-27.&lt;br&gt;No joins, no calculations.&lt;/font&gt;' id="b7"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5DA;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="490" y="196" width="380" height="120" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:13px"&gt;Tabs&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;stg_grants  (Grants (cleaned))&lt;br&gt;stg_organisations  (Organisations (cleaned))&lt;br&gt;stg_outcome_progress  (Outcome progress (cleaned))&lt;br&gt;stg_support  (Support requests (cleaned))&lt;br&gt;stg_decisions  (Decisions (cleaned))&lt;br&gt;stg_dividends  (Dividends (cleaned))&lt;br&gt;stg_disbursements  (Payments (cleaned))&lt;br&gt;stg_maturity  (Maturity (cleaned))&lt;/font&gt;' id="b8"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#F4F6F9;strokeColor=#CBD5DA;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="490" y="332" width="380" height="238" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:18px"&gt;Final&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#E2F2F4"&gt;6 tables, prefix fct_&lt;/font&gt;' id="b9"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#0E4A5C;strokeColor=#0E4A5C;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="940" y="110" width="380" height="70" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:13px"&gt;What happens here&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;Dashboard-ready tables:&lt;br&gt;join the cleaned tables, calculate,&lt;br&gt;build ready-to-show text and sort numbers.&lt;br&gt;Each is built straight from staging.&lt;/font&gt;' id="b10"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5DA;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="940" y="196" width="380" height="120" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:13px"&gt;Tabs&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;fct1_grant_portfolio  (Grant portfolio)&lt;br&gt;fct2_outcome_progress  (Outcome progress by quarter)&lt;br&gt;fct3_support_activity  (Support activity)&lt;br&gt;fct4_budget_year  (Budget by year)&lt;br&gt;fct5_maturity_rag  (Maturity ratings)&lt;br&gt;fct6_grantee_annual_info  (Annual information, selected and previous year)&lt;/font&gt;' id="b11"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#F4F6F9;strokeColor=#CBD5DA;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="940" y="332" width="380" height="190" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:18px"&gt;Dashboard&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#E2F2F4"&gt;Looker Studio, 5 pages&lt;/font&gt;' id="b12"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#245563;strokeColor=#245563;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1390" y="110" width="380" height="70" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:13px"&gt;What happens here&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;One data source per final table.&lt;br&gt;Metrics count and add the final columns;&lt;br&gt;filters choose the year, status or organisation.&lt;/font&gt;' id="b13"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5DA;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1390" y="196" width="380" height="120" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:13px"&gt;Tabs&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;Guide&lt;br&gt;Portfolio Overview&lt;br&gt;Funding Allocation&lt;br&gt;Decision Queue&lt;br&gt;Grantee 360&lt;/font&gt;' id="b14"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#F4F6F9;strokeColor=#CBD5DA;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1390" y="332" width="380" height="166" as="geometry"/></mxCell></object><object label='&lt;b style="font-size:14px"&gt;Why there is no intermediate layer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px" color="#5F6C77"&gt;An intermediate layer is useful when the same joined data is needed by several final tables. Here every final table is one readable join of cleaned tables, so the extra step would only add tabs.&lt;br&gt;One final table (annual information, fct6) is reshaped from the grant portfolio (fct1); if a second table needs the same reshaping, that is the time to add one.&lt;/font&gt;' id="b15"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=1;arcSize=6;fillColor=#E2F2F4;strokeColor=#167C88;fontColor=#1E2838;align=left;verticalAlign=top;spacing=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1760" height="90" as="geometry"/></mxCell></object><mxCell id="e0" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#167C88;strokeWidth=2.4;jettySize=auto;orthogonalLoop=1;fontSize=11;fontColor=#5F6C77;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b5" target="b8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#167C88;strokeWidth=2.4;jettySize=auto;orthogonalLoop=1;fontSize=11;fontColor=#5F6C77;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b8" target="b11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=block;endFill=1;rounded=0;strokeColor=#167C88;strokeWidth=2.4;jettySize=auto;orthogonalLoop=1;fontSize=11;fontColor=#5F6C77;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b11" target="b14"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page3" name="3. Source: what we read"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="1984" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><object label="Source: what we read" id="t1"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=26;fontColor=#0E4A5C;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="30" as="geometry"/></mxCell></object><object label="The columns of the APFP Central Administration workbook that the pipeline uses. Other columns in the workbook are not read." id="t2"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#5F6C77;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1700" height="24" as="geometry"/></mxCell></object><object label='&lt;b&gt;8. Grant Registry&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px" color="#CFE3E6"&gt;One row per grant: organisation, amount, dates, status, team and budget&lt;/font&gt;' id="T3" description="One row per grant: organisation, amount, dates, status, team and budget"><mxCell style="swimlane;fontStyle=1;startSize=46;html=1;whiteSpace=wrap;fillColor=#5F6C77;strokeColor=#5F6C77;fontColor=#FFFFFF;fontSize=14;align=left;spacingLeft=10;collapsible=0;rounded=0;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="340" height="874" as="geometry"/></mxCell></object><object label="&lt;b&gt;Grant ID&lt;/b&gt;" id="r4" tech="Grant ID" kind="Identifier (a key)"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=#E1D5E7;strokeColor=#B9C5CB;align=left;spacingLeft=8;verticalAlign=middle;fontSize=12;fontColor=#1E2838;" vertex="1" parent="T3"><mxGeometry x="0" y="46" width="260" height="36" as="geometry"/></mxCell></object><object label="text" id="r5"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=#E1D5E7;strokeColor=#B9C5CB;align=center;verticalAlign=middle;fontSize=11;fontColor=#5F6C77;" vertex="1" parent="T3"><mxGeometry x="260" y="46" width="80" height="36" as="geometry"/></mxCell></object><object label="&lt;b&gt;Financial Year&lt;/b&gt;" id="r6" tech="Financial Year" kind="Text / grouping field"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=#FFFFFF;strokeColor=#B9C5CB;align=left;spacingLeft=8;verticalAlign=middle;fontSize=12;fontColor=#1E2838;" vertex="1" parent="T3"><mxGeometry x="0" y="82" width="260" height="36" as="geometry"/></mxCell></object><object label="text" id="r7"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=#FFFFFF;strokeColor=#B9C5CB;align=center;verticalAlign=middle;fontSize=11;fontColor=#5F6C77;" vertex="1" parent="T3"><mxGeometry x="260" y="82" width="80" height="36" as="geometry"/></mxCell></object><object label="&lt;b&gt;Grant Start Quarter&lt;/b&gt;" id="r8" tech="Grant Start Quarter" kind="Text / grouping field"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=#FFFFFF;strokeColor=#B9C5CB;align=left;spacingLeft=8;verticalAlign=middle;fontSize=12;fontColor=#1E2838;" vertex="1" parent="T3"><mxGeometry x="0" y="118" width="260" height="36" as="geometry"/></mxCell></object><object label="text" id="r9"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=#FFFFFF;strokeColor=#B9C5CB;align=center;verticalAlign=middle;fontSize=11;fontColor=#5F6C77;" vertex="1" parent="T3"><mxGeometry x="260" y="118" width="80" height="36" as="geometry"/></mxCell></object><object label="&lt;b&gt;Organisation ID&lt;/b&gt;" id="r10" tech="Organisation ID" kind="Identifier (a key)"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=#E1D5E7;strokeColor=#B9C5CB;align=left;spacingLeft=8;verticalAlign=middle;fontSize=12;fontColor=#1E2838;" vertex="1" parent="T3"><mxGeometry x="0" y="154" width="260" height="36" as="geometry"/></mxCell></object><object label="text" id="r11"><mxCell style="html=1;whiteSpace=wrap;fontFamily=Helvetica;rounded=0;fillColor=#E1D5E7