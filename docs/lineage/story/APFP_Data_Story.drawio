<mxfile host="app.diagrams.net"><diagram name="How the dashboard numbers are made" id="story"><mxGraphModel dx="1500" dy="960" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="960"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;How the dashboard numbers are made&lt;/b&gt;&lt;br&gt;Programme staff type the data once. The scripts clean it and build six dashboard-ready tables. The dashboard only reads those tables." style="text;html=1;align=left;fontSize=16;fontColor=#0E4A5C;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1000" height="60" as="geometry"/></mxCell><mxCell id="n1" value='&lt;b&gt;1  Where staff type&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;APFP Central Administration workbook&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#167C88;strokeColor=none;align=left;spacingLeft=14;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="400" height="46" as="geometry"/></mxCell><mxCell id="n2" value='&lt;b&gt;2  Dashboard-ready tables&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;cleaned and combined by the scripts&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#167C88;strokeColor=none;align=left;spacingLeft=14;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590" y="92" width="360" height="46" as="geometry"/></mxCell><mxCell id="n3" value='&lt;b&gt;3  Where you see it&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Looker Studio dashboard pages&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#167C88;strokeColor=none;align=left;spacingLeft=14;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1140" y="92" width="320" height="46" as="geometry"/></mxCell><mxCell id="n4" value='&lt;b&gt;Grant register&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;8. Grant Registry  ·  Grants, amounts, dates, status&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9C5CB;strokeWidth=1.5;align=left;spacingLeft=18;fontSize=14;fontColor=#1E2838;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="400" height="64" as="geometry"/></mxCell><mxCell id="n5" value='&lt;b&gt;Organisation register&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;9. Organisation Registry  ·  Mission, policies, registration&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9C5CB;strokeWidth=1.5;align=left;spacingLeft=18;fontSize=14;fontColor=#1E2838;" vertex="1" parent="1"><mxGeometry x="40" y="234" width="400" height="64" as="geometry"/></mxCell><mxCell id="n6" value='&lt;b&gt;Decision tracker&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;4. Decision Tracker  ·  Renew / close recommendations&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9C5CB;strokeWidth=1.5;align=left;spacingLeft=18;fontSize=14;fontColor=#1E2838;" vertex="1" parent="1"><mxGeometry x="40" y="318" width="400" height="64" as="geometry"/></mxCell><mxCell id="n7" value='&lt;b&gt;Outcome progress&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;2. Outcome Progress  ·  Targets and quarterly progress&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9C5CB;strokeWidth=1.5;align=left;spacingLeft=18;fontSize=14;fontColor=#1E2838;" vertex="1" parent="1"><mxGeometry x="40" y="402" width="400" height="64" as="geometry"/></mxCell><mxCell id="n8" value='&lt;b&gt;Organisation maturity&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;7. Organisation Maturity  ·  Red / Amber / Green ratings&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9C5CB;strokeWidth=1.5;align=left;spacingLeft=18;fontSize=14;fontColor=#1E2838;" vertex="1" parent="1"><mxGeometry x="40" y="486" width="400" height="64" as="geometry"/></mxCell><mxCell id="n9" value='&lt;b&gt;Support requests&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;3. Support  ·  Help asked for and given&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9C5CB;strokeWidth=1.5;align=left;spacingLeft=18;fontSize=14;fontColor=#1E2838;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="400" height="64" as="geometry"/></mxCell><mxCell id="n10" value='&lt;b&gt;Committed and spent&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;6. Committed &amp;amp; Spent Tracker  ·  Planned and actual payments&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9C5CB;strokeWidth=1.5;align=left;spacingLeft=18;fontSize=14;fontColor=#1E2838;" vertex="1" parent="1"><mxGeometry x="40" y="654" width="400" height="64" as="geometry"/></mxCell><mxCell id="n11" value='&lt;b&gt;Dividends&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;5. Dividends  ·  Dividend income per year&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B9C5CB;strokeWidth=1.5;align=left;spacingLeft=18;fontSize=14;fontColor=#1E2838;" vertex="1" parent="1"><mxGeometry x="40" y="738" width="400" height="64" as="geometry"/></mxCell><mxCell id="n12" value='&lt;b&gt;Grant portfolio&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;One row per grant: funding, decision, ratings&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#167C88;strokeWidth=1.5;align=left;spacingLeft=18;fontSize=14;fontColor=#1E2838;" vertex="1" parent="1"><mxGeometry x="590" y="154" width="360" height="64" as="geometry"/></mxCell><mxCell id="n13" value='&lt;b&gt;Annual information&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;This year next to last year (built from the portfolio)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6C77;strokeWidth=1.5;align=left;spacingLeft=18;fontSize=14;fontColor=#1E2838;" vertex="1" parent="1"><mxGeometry x="590" y="266" width="360" height="64" as="geometry"/></mxCell><mxCell id="n14" value='&lt;b&gt;Outcome progress&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;One row per outcome and quarter&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EB6834;strokeWidth=1.5;align=left;spacingLeft=18;fontSize=14;fontColor=#1E2838;" vertex="1" parent="1"><mxGeometry x="590" y="378" width="360" height="64" as="geometry"/></mxCell><mxCell id="n15" value='&lt;b&gt;Maturity ratings&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;One row per maturity indicator&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A6A2F;strokeWidth=1.5;align=left;spacingLeft=18;fontSize=14;fontColor=#1E2838;" vertex="1" parent="1"><mxGeometry x="590" y="490" width="360" height="64" as="geometry"/></mxCell><mxCell id="n16" value='&lt;b&gt;Support activity&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;One row per support request&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A3AA7;strokeWidth=1.5;align=left;spacingLeft=18;fontSize=14;fontColor=#1E2838;" vertex="1" parent="1"><mxGeometry x="590" y="602" width="360" height="64" as="geometry"/></mxCell><mxCell id="n17" value='&lt;b&gt;Budget by year&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;Dividends, commitments, payments, balance&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E87BA4;strokeWidth=1.5;align=left;spacingLeft=18;fontSize=14;fontColor=#1E2838;" vertex="1" parent="1"><mxGeometry x="590" y="714" width="360" height="64" as="geometry"/></mxCell><mxCell id="n18" value='&lt;b&gt;Portfolio&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;Who we fund and how they are doing  ·  16 charts&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F2F4;strokeColor=#9CC9D0;strokeWidth=1.5;align=left;spacingLeft=18;fontSize=14;fontColor=#1E2838;" vertex="1" parent="1"><mxGeometry x="1140" y="180" width="320" height="76" as="geometry"/></mxCell><mxCell id="n19" value='&lt;b&gt;Funding&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;Money in, committed, paid out  ·  12 charts&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F2F4;strokeColor=#9CC9D0;strokeWidth=1.5;align=left;spacingLeft=18;fontSize=14;fontColor=#1E2838;" vertex="1" parent="1"><mxGeometry x="1140" y="330" width="320" height="76" as="geometry"/></mxCell><mxCell id="n20" value='&lt;b&gt;Decision Queue&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;Renewals and closures to decide  ·  7 charts&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F2F4;strokeColor=#9CC9D0;strokeWidth=1.5;align=left;spacingLeft=18;fontSize=14;fontColor=#1E2838;" vertex="1" parent="1"><mxGeometry x="1140" y="480" width="320" height="76" as="geometry"/></mxCell><mxCell id="n21" value='&lt;b&gt;Grantee 360&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px" color="#5F6C77"&gt;One organisation in full  ·  8 charts&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F2F4;strokeColor=#9CC9D0;strokeWidth=1.5;align=left;spacingLeft=18;fontSize=14;fontColor=#1E2838;" vertex="1" parent="1"><mxGeometry x="1140" y="630" width="320" height="76" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;html=1;strokeColor=#167C88;strokeWidth=2;endArrow=oval;endFill=1;" edge="1" parent="1" source="n4" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;html=1;strokeColor=#167C88;strokeWidth=2;endArrow=oval;endFill=1;" edge="1" parent="1" source="n5" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edge